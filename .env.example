# Required. The folder to serve, for example /mnt/content.
STORAGE_ROOT=

# Local state: database and thumbnails. Create it first and give it to PUID.
STATE_DIR=./state
PUID=1000
PGID=1000

# Where the app listens on the host. Use 0.0.0.0 for the LAN.
BIND_ADDR=127.0.0.1
PORT=8080

# Base URLs. Their scheme decides the Secure cookie flag.
PUBLIC_URL=http://localhost:8080
SHARE_URL=http://localhost:8080

# Uploads are refused below this much free space.
MIN_FREE_BYTES=5368709120

# Profile tailscale. TS_EXPOSE=funnel adds public share links on port 8443.
TS_AUTHKEY=
TS_HOSTNAME=storage
TS_EXPOSE=tailnet
