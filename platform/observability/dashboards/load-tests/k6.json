          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(k6_vus, testid)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "definition": "label_values(k6_vus, testid)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "regex": "",
        "hide": 0,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      }
    ]
  },
