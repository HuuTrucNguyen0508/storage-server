# Committed defaults for the local profile (native k3s on this machine). Put overrides in config/override.env (untracked).
PROFILE=local
DOMAIN=lab.localhost
CLUSTER_NAME=lab
# Traefik takes HTTP_PORT and HTTPS_PORT as node ports, and kube-proxy serves them only on
# LISTEN_ADDRESS (0.0.0.0: every address). Both ports must be 32767 or lower.
LISTEN_ADDRESS=127.0.0.1
HTTP_PORT=80
HTTPS_PORT=443
AUTH_POLICY=one_factor
# Issuer for the wildcard certificate: lab-ca (local root CA) or letsencrypt-dns01 (remote profile).
CERT_ISSUER=lab-ca
ENVIRONMENT=local
# Host directory for data that must survive a cluster rebuild (relative paths resolve from the repo root).
DATA_DIR=.local/data
# The storage pod runs in this group and writes its files readable to it, so make offsite can
# back them up. Defaults to your primary group (id -g); set it to another of your groups if needed.
# DATA_GID=1000
