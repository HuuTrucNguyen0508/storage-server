{
  "TCP": { "443": { "HTTPS": true }, "8443": { "HTTPS": true } },
  "Web": {
    "${TS_CERT_DOMAIN}:443": {
      "Handlers": {
        "/": { "Proxy": "http://app:8080" },
        "/pdf/": { "Proxy": "http://pdf:8080/pdf/" }
      }
    },
    "${TS_CERT_DOMAIN}:8443": {
      "Handlers": { "/": { "Proxy": "http://app:8081" } }
    }
  },
  "AllowFunnel": { "${TS_CERT_DOMAIN}:8443": true }
}
