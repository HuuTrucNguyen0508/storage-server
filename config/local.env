# Committed defaults for the local kind cluster. Put overrides in config/override.env (untracked).
PROFILE=local
DOMAIN=lab.localhost
CLUSTER_NAME=lab
LISTEN_ADDRESS=127.0.0.1
HTTP_PORT=80
HTTPS_PORT=443
AUTH_POLICY=one_factor
ENVIRONMENT=local
# Host directory for data that must survive a cluster rebuild (relative paths resolve from the repo root).
DATA_DIR=.local/data
