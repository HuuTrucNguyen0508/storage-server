# Storage and state directories must exist and be writable by PUID before starting.
# TS_STATE_DIR is a dedicated directory required by the Tailscale profile.
STORAGE_ROOT=./data
STATE_DIR=./state
TS_STATE_DIR=./tailscale-state
PUID=1000
PGID=1000
BIND_ADDR=127.0.0.1
PORT=8080
PUBLIC_URL=http://localhost:8080
SHARE_URL=http://localhost:8080
MIN_FREE_BYTES=5368709120
# Required even without monitoring. Choose a unique password.
GRAFANA_PASSWORD=
GRAFANA_PORT=3000
PROMETHEUS_PORT=9091
PDF_PORT=8082
# Optional comma-separated profiles: pdf,monitoring,tailscale
COMPOSE_PROFILES=
# tailscale profile. HTTPS tailnet 443, PDF 8444, optional guest Funnel 8443.
TS_AUTHKEY=
TS_HOSTNAME=storage
TS_EXPOSE=tailnet
TS_EXTRA_ARGS=
