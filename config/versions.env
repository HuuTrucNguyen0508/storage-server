# Pinned tool, chart and image versions. scripts/lib.sh loads this after config/local.env.
# scripts/tools.sh downloads kubectl into .local/bin and the k3s binary and its install script
# into .local/k3s, and checks each against these SHA-256 sums.

# k3s v1.37.2+k3s1 (the stable channel) runs Kubernetes 1.37.2; kubectl stays within one minor
# of the server.
K3S_VERSION=v1.37.2+k3s1
K3S_SHA256_LINUX_AMD64=265b3ee6a3198ef14033c63ef46cbb32370d83795199fb6d1b01f21575eddbda
K3S_SHA256_LINUX_ARM64=a779ccf1e5e2e33a62f5a29c2f1c0bbf99431e100579d4c10f0aa0742a6aa84b
# install.sh at the same tag: writes the systemd unit, k3s-killall.sh and k3s-uninstall.sh.
K3S_INSTALL_SH_SHA256=ed01f89fd977bf20ac1516bbebf8370bf3ddbaa55dac8aba610956a4c78cc00b
KUBECTL_VERSION=v1.37.2
KUBECTL_SHA256_LINUX_AMD64=c04487523e7aa7d1493f7808174c899db93d7a9cf57531420cd76b9bd415f8f4
KUBECTL_SHA256_LINUX_ARM64=fcc16f63186659d9722014b7e02d5fdd2d4e669cb8c0ab66365d7d3b8ba03509

# Helm charts.
CERT_MANAGER_CHART_VERSION=v1.21.3
# Traefik chart 42.3.0 ships Traefik v3.7.17.
TRAEFIK_CHART_VERSION=42.3.0
# CloudNativePG chart 0.29.1 ships operator 1.30.1 (PostgreSQL 18 by default).
CNPG_CHART_VERSION=0.29.1
PROMETHEUS_OPERATOR_CRDS_VERSION=32.0.2

# Images (tag plus digest).
AUTHELIA_IMAGE=authelia/authelia:4.39.28@sha256:bd97cff4fcbf715b5ff1f9ae286afbe6033afce385302520b0368122d43a6f54
STIRLING_PDF_IMAGE=stirlingtools/stirling-pdf:3.2.2@sha256:c6872dd056b0046a14c5de1e9970283e7f1e1ff685bb08090c6b37a231127d31
# Also pinned in services/home/Dockerfile (ARG NGINX_IMAGE).
NGINX_UNPRIVILEGED_IMAGE=nginxinc/nginx-unprivileged:1.31.7-alpine3.24@sha256:b5047b9b76845eac124358373c6852377c52e4b05834a47647e955dd91cb8f1e
WHOAMI_IMAGE=traefik/whoami:v1.12.0@sha256:c4717a8d1f0134a7444e24f881160e033991f23027c6c5a9a3f8fd22e70d1d44
# PostgreSQL client for backup Jobs; its major must match CloudNativePG's server image (18).
POSTGRES_CLIENT_IMAGE=postgres:18.6-alpine3.24@sha256:10a5c69a83035ab5239f5620d708520e8b28f5aa1f2b20143e6024532edadfb5
CURL_IMAGE=curlimages/curl:8.17.0@sha256:935d9100e9ba842cdb060de42472c7ca90cfe9a7c96e4dacb55e79e560b3ff40
