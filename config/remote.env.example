# Copy to config/override.env to run the remote profile (see platform/README.md).
# The DNS-01 issuer is an unverified template. Try it with Let's Encrypt staging first.
PROFILE=remote
DOMAIN=lab.example.com
# The address friends reach, for example this machine's Tailscale IP. Ports 80/443 on it must be free.
LISTEN_ADDRESS=100.64.0.10
AUTH_POLICY=two_factor
ENVIRONMENT=remote
CERT_ISSUER=letsencrypt-dns01
ACME_EMAIL=you@example.com
